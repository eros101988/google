# Environment Variables

# App Url (e.g. https://admin.example.com or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL for NFC short links (e.g. https://go.example.com or http://localhost:3000)
NEXT_PUBLIC_REDIRECT_BASE_URL=http://localhost:3000

# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Used for backend API routes / edge functions to bypass RLS if necessary
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Places API (Optional, for admin panel merchant search)
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Cloudflare Configuration (For Redirect Worker KV)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_KV_NAMESPACE_ID=your_cloudflare_kv_namespace_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
